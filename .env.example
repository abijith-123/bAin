# Copy to .env for local settings. Never commit .env or real credentials.
BAIN_API_BASE_URL=http://127.0.0.1:8000
BAIN_LLM_PROVIDER=disabled
GROQ_API_KEY=

# Synthetic local demo tokens only. Replace these for your own local demo.
# These are not suitable for deployment or real patient data.
BAIN_TOKEN_ADMIN=local-demo-admin
BAIN_TOKEN_DOCTOR=local-demo-doctor
BAIN_TOKEN_NURSE=local-demo-nurse
BAIN_TOKEN_PHARMACIST=local-demo-pharmacist
BAIN_TOKEN_BILLING_SPECIALIST=local-demo-billing-specialist
BAIN_TOKEN_TRANSPORT_STAFF=local-demo-transport-staff
BAIN_TOKEN_HOUSEKEEPING=local-demo-housekeeping

BAIN_TOKEN_BILLING_SUPERVISOR=
BAIN_INSURANCE_SLA_MINUTES=30

BAIN_TOKEN_SOCIAL_WORKER=local-demo-social-worker
