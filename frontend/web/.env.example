# Optional API base URL for direct browser requests.
# In local dev, Vite proxies /api to http://127.0.0.1:8000 by default.
# Local synthetic role tokens are included only for the demo role selector.
# VITE_* values are delivered to the browser; never put real secrets or LLM API keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_BAIN_TOKEN_ADMIN=local-demo-admin
VITE_BAIN_TOKEN_DOCTOR=local-demo-doctor
VITE_BAIN_TOKEN_NURSE=local-demo-nurse
VITE_BAIN_TOKEN_PHARMACIST=local-demo-pharmacist
VITE_BAIN_TOKEN_BILLING_SPECIALIST=local-demo-billing-specialist
VITE_BAIN_TOKEN_TRANSPORT_STAFF=local-demo-transport-staff
VITE_BAIN_TOKEN_HOUSEKEEPING=local-demo-housekeeping
VITE_BAIN_TOKEN_BILLING_SUPERVISOR=

VITE_BAIN_TOKEN_SOCIAL_WORKER=local-demo-social-worker
